# ─── Base de DÉVELOPPEMENT : base Neon existante (jamais de vraies valeurs ici) ───
# Jamais de migration destructrice ni de nettoyage de tests sur cette base.
# Connexion « pooled » (hôte avec -pooler) : utilisée par l'API à l'exécution.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Connexion directe (hôte SANS -pooler) : utilisée par les migrations Prisma.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ─── Base de TEST : branche Neon « test » (obligatoire pour les tests automatisés) ───
# Les tests d'intégration et E2E créent puis suppriment des données : ils refusent de
# s'exécuter sans ces variables, ou si elles désignent la base de développement.
# Ne jamais définir sur Railway.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-yyyy-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
TEST_DIRECT_URL="postgresql://USER:PASSWORD@ep-yyyy.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ─── Serveur ───
NODE_ENV=development
# En local. Sur Railway, la variable PORT est prioritaire (fixez-la, ex. 8080).
API_PORT=4000
# Origine(s) publique(s) du frontend, séparées par des virgules (protection CSRF et CORS).
WEB_ORIGIN=http://localhost:3000
# Nombre de proxys de confiance devant l'API (Railway + proxy Next.js) pour l'IP réelle du client.
TRUST_PROXY_HOPS=1
# Documentation Swagger sur /api/docs (désactivée par défaut en production).
# SWAGGER_ENABLED=true

# ─── Session (cookie httpOnly) ───
SESSION_TTL_HOURS=12
# true obligatoire en production (HTTPS).
COOKIE_SECURE=false

# ─── Double authentification des comptes internes Ocall (Sprint 11A) — voir docs/OCALL-SUITE.md ───
# Clé de chiffrement des secrets TOTP : 32 octets en base64, OBLIGATOIRE en production.
# Génération : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Absente en développement : l'enrôlement MFA est indisponible (les rôles sensibles sont bloqués).
# Ne jamais la changer sans réinitialiser la MFA des comptes internes (pnpm db:reset-mfa).
# MFA_ENCRYPTION_KEY=

# ─── Fichiers privés et journaux (Sprint 11B) — voir docs/PRODUCTION.md ───
# Signature des liens temporaires de téléchargement : 32 octets base64 au moins, OBLIGATOIRE en
# production. Absente ailleurs : clé aléatoire à chaque démarrage (liens invalidés au redémarrage).
# STORAGE_SIGNING_SECRET=
# Format des journaux : json (défaut en production) ou text (défaut en développement).
# LOG_FORMAT=text

# ─── Protection contre les tentatives répétées ───
LOGIN_THROTTLE_LIMIT=10
LOGIN_THROTTLE_TTL_SECONDS=60
ACCOUNT_LOCK_THRESHOLD=5
ACCOUNT_LOCK_MINUTES=15

# ─── Réinitialisation du mot de passe ───
PASSWORD_RESET_TTL_MINUTES=30

# ─── Intelligence artificielle (Sprint 8) — voir docs/INTELLIGENCE-ARTIFICIELLE.md ───
# none (défaut) : IA désactivée, l'application fonctionne normalement.
# simulated : fournisseur déterministe sans réseau ni coût (développement, tests ; interdit en production).
# openai : appels RÉELS facturés ; exige OPENAI_API_KEY ET AI_REAL_CALLS_ENABLED=true.
AI_PROVIDER=none
# AI_REAL_CALLS_ENABLED=true
# Clé secrète OpenAI : côté serveur uniquement, jamais dans le navigateur ni dans Git.
# OPENAI_API_KEY=
# Modèle de langage par défaut, puis surcharge éventuelle par fonctionnalité.
# OPENAI_MODEL=gpt-5
# OPENAI_MODEL_CATALOG_IMPORT=gpt-5
# OPENAI_MODEL_COPILOT=gpt-5
# OPENAI_MODEL_VOICE_ORDER=gpt-5
# Modèle de transcription (gpt-transcribe accepte les noms de plats comme mots-clés).
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# Délai maximal d'un appel IA (ms) et taux indicatif USD → FCFA des coûts estimés.
# AI_TIMEOUT_MS=60000
# AI_USD_XOF_RATE=600

# ─── Sites vitrines (Sprint 10) — voir docs/SITES-VITRINES.md ───
# Origine des pages /e/<slug> (frontend). Par défaut : première valeur de WEB_ORIGIN.
# SITES_PUBLIC_ORIGIN=https://app.ocallpark.com
# Domaine des sous-domaines <slug>.<domaine> : à définir SEULEMENT une fois le domaine acquis,
# le DNS wildcard et le certificat configurés et testés.
# SITES_BASE_DOMAIN=ocallpark.com
# SITES_SUBDOMAINS_ENABLED=true
# Cible CNAME indiquée aux clients pour leur domaine personnalisé (fournie par l'hébergeur).
# SITES_CUSTOM_DOMAIN_TARGET=xxxx.up.railway.app
# Régénération des pages publiques après publication (même secret côté web).
# SITES_REVALIDATE_URL=http://web.railway.internal:8080/api/site-revalidate
# SITES_REVALIDATE_SECRET=
# Vérifications DNS / HTTPS des domaines : réelles par défaut ; « simulated » réservé aux tests.
# SITES_DOMAIN_VERIFIER=simulated
# Stockage des médias : local (développement) ou s3 (compatible S3 : Cloudflare R2 retenu).
MEDIA_STORAGE=local
# MEDIA_STORAGE_DIR=.media
# Cloudflare R2 :
# MEDIA_STORAGE=s3
# S3_ENDPOINT=https://<ID_COMPTE>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=ocall-sites
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ─── Paiement en ligne des factures SaaS (Sprint 12A) — voir docs/PAIEMENT-EN-LIGNE.md ───
# none (défaut) | simulated (tests, interdit en production) | cinetpay (adaptateur non livré).
# ONLINE_PAYMENT_PROVIDER=none
# Adresse publique de l'API (URL de notification), https en production.
# API_PUBLIC_URL=http://localhost:4000
# Adresse de l'application web (retour du client après paiement).
# WEB_APP_URL=http://localhost:3000
# ONLINE_PAYMENT_PENDING_TTL_MINUTES=30
# Demandes de démonstration du site public acceptées par IP sur 10 minutes.
# PUBLIC_LEAD_THROTTLE_LIMIT=5
