# ─── Base de données Neon (jamais de vraies valeurs dans ce fichier) ───
# Connexion « pooled » (hôte avec -pooler) : utilisée par l'API à l'exécution.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Connexion directe (hôte SANS -pooler) : utilisée par les migrations Prisma.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ─── Base de TEST : branche Neon « development » (obligatoire pour les tests) ───
# Les tests d'intégration et E2E créent puis suppriment des données : ils refusent de
# s'exécuter sans ces variables, ou si elles désignent la même base que DATABASE_URL.
# Ne pas définir sur Railway.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-yyyy-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
TEST_DIRECT_URL="postgresql://USER:PASSWORD@ep-yyyy.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ─── Serveur ───
NODE_ENV=development
# En local. Sur Railway, la variable PORT est prioritaire (fixez-la, ex. 8080).
API_PORT=4000
# Origine(s) publique(s) du frontend, séparées par des virgules (protection CSRF et CORS).
WEB_ORIGIN=http://localhost:3000
# Nombre de proxys de confiance devant l'API (Railway + proxy Next.js) pour l'IP réelle du client.
TRUST_PROXY_HOPS=1
# Documentation Swagger sur /api/docs (désactivée par défaut en production).
# SWAGGER_ENABLED=true

# ─── Session (cookie httpOnly) ───
SESSION_TTL_HOURS=12
# true obligatoire en production (HTTPS).
COOKIE_SECURE=false

# ─── Protection contre les tentatives répétées ───
LOGIN_THROTTLE_LIMIT=10
LOGIN_THROTTLE_TTL_SECONDS=60
ACCOUNT_LOCK_THRESHOLD=5
ACCOUNT_LOCK_MINUTES=15

# ─── Réinitialisation du mot de passe ───
PASSWORD_RESET_TTL_MINUTES=30
