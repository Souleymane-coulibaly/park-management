{
  "name": "ocall-park",
  "version": "0.1.0",
  "private": true,
  "description": "Ocall Park — logiciel SaaS de gestion pour parcs aquatiques et restaurants en Afrique.",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:packages": "pnpm --filter @ocall/shared --filter @ocall/database run build",
    "dev": "pnpm --parallel --filter @ocall/api --filter @ocall/web run dev",
    "dev:api": "pnpm --filter @ocall/api run dev",
    "dev:web": "pnpm --filter @ocall/web run dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:integration": "node scripts/run-with-log.mjs integration pnpm --filter @ocall/api run test:integration",
    "test:e2e": "node scripts/run-with-log.mjs e2e playwright test",
    "db:generate": "pnpm --filter @ocall/database run generate",
    "db:check": "pnpm --filter @ocall/database run check",
    "db:migrate:check": "pnpm --filter @ocall/database run migrate:check",
    "db:migrate:create": "pnpm --filter @ocall/database run migrate:create",
    "db:migrate:deploy": "pnpm --filter @ocall/database run migrate:deploy",
    "db:migrate:deploy:test": "pnpm --filter @ocall/database run migrate:deploy:test",
    "db:migrate:status": "pnpm --filter @ocall/database run migrate:status",
    "db:bootstrap-super-admin": "pnpm --filter @ocall/database run bootstrap-super-admin",
    "db:reset-mfa": "pnpm --filter @ocall/database run reset-mfa"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@next/eslint-plugin-next": "^15.1.0",
    "@ocall/database": "workspace:*",
    "@playwright/test": "^1.55.0",
    "dotenv": "^16.6.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
