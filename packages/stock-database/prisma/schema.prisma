// Ocall Stock : base PostgreSQL distincte des bases Ocall Suite, School et Facture.
//
// `organizationId` et `userId` désignent des lignes de la base Suite : aucune clé étrangère entre bases,
// l'API les contrôle. Dans cette base, chaque lien passe par une clé composée (organizationId, id) :
// PostgreSQL refuse lui-même tout lien entre deux organisations.
//
// Montants : entiers dans l'unité de la devise de l'organisation (le franc CFA n'a pas de décimales).
// Prix de vente TTC (prix payé par le client, imprimé sur l'étiquette) ; prix d'achat HT.
//
// Contrôles, déclencheurs (historiques en ajout seul) et index de recherche (pg_trgm) sont écrits à la
// main dans les migrations.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/stock-client"
}

datasource db {
  provider  = "postgresql"
  url       = env("STOCK_DATABASE_URL")
  directUrl = env("STOCK_DIRECT_URL")
}

/// Rôle d'un membre Ocall Stock. Le propriétaire de l'organisation (base Suite) est administrateur d'office.
enum StockRole {
  ADMIN
  STORE_MANAGER
  WAREHOUSE_MANAGER
  STOREKEEPER
  CASHIER
  SALES
  AUDITOR
}

/// Type d'un code-barres. Les codes GTIN (EAN-13, EAN-8, UPC-A) viennent du fabricant et ne sont jamais
/// inventés ; le code interne est généré par Ocall Stock (imprimé en Code 128 ou en QR code).
enum StockBarcodeType {
  EAN13
  EAN8
  UPCA
  INTERNAL
}

/// Compteurs de l'organisation : références d'articles et codes internes.
enum StockCounterKind {
  SKU
  INTERNAL_CODE
  TRANSFER
  COUNT
  PURCHASE
  RECEIPT
  SUPPLIER_RETURN
  SALE
  SALE_RETURN
  CASH_SESSION
}

/// Prix suivi dans l'historique des prix.
enum StockPriceKind {
  SALE
  PURCHASE
}

/// Réglages Ocall Stock d'une organisation.
model StockSettings {
  organizationId     String   @id @db.Uuid
  /// Nom imprimé sur les étiquettes et, plus tard, les tickets.
  storeName          String
  /// TVA proposée pour un nouvel article (0 à 30 %).
  defaultVatRate     Int      @default(18)
  /// Préfixe des codes internes et des références générées (2 à 4 lettres majuscules).
  internalCodePrefix String   @default("OC")
  /// Stock négatif autorisé (sortie au-delà du stock). Refusé par défaut (S2).
  allowNegativeStock Boolean  @default(false)
  /// Remise la plus forte (en % du montant de la ligne) qu'un membre autorisé peut accorder en caisse ;
  /// au-delà, le droit « remises sans plafond » est exigé (S4).
  maxDiscountPercent Int      @default(10)
  /// Coordonnées et mention de pied imprimées sur les tickets (S4).
  receiptPhone       String?
  receiptAddress     String?
  receiptFooter      String?
  /// Emplacement d'où sortent (et où reviennent) les marchandises vendues par Ocall Facture : factures,
  /// pièces d'interventions, avoirs « marchandise retournée » (S5). Sans lui, ces demandes échouent.
  factureLocationId  String?  @db.Uuid
  updatedByUserId    String?  @db.Uuid
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  factureLocation StockLocation? @relation("StockFactureLocation", fields: [organizationId, factureLocationId], references: [organizationId, id], onDelete: Restrict)
}

/// Membre Ocall Stock : compte Suite (rôle PRODUCT_USER) avec un rôle Stock.
model StockMember {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  userId         String    @db.Uuid
  firstName      String
  lastName       String
  loginId        String
  role           StockRole
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  permissions StockMemberPermission[]
  sites       StockMemberSite[]

  @@unique([organizationId, id])
  @@unique([organizationId, userId])
  @@index([organizationId, isActive])
}

/// Ajustement d'une permission pour un membre : accordée (en plus de son rôle) ou retirée.
model StockMemberPermission {
  organizationId  String   @db.Uuid
  memberId        String   @db.Uuid
  permission      String
  granted         Boolean
  updatedByUserId String   @db.Uuid
  updatedAt       DateTime @updatedAt

  member StockMember @relation(fields: [organizationId, memberId], references: [organizationId, id], onDelete: Cascade)

  @@id([memberId, permission])
  @@index([organizationId, memberId])
}

/// Compteur continu par organisation (références SKU, codes internes).
model StockNumberCounter {
  organizationId String           @db.Uuid
  kind           StockCounterKind
  value          Int              @default(0)
  updatedAt      DateTime         @updatedAt

  @@id([organizationId, kind])
}

/// Catégorie (niveau 1) ou sous-catégorie (niveau 2) du catalogue.
model StockCategory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  parentId       String?  @db.Uuid
  name           String
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent   StockCategory?  @relation("StockCategoryTree", fields: [organizationId, parentId], references: [organizationId, id], onDelete: Restrict)
  children StockCategory[] @relation("StockCategoryTree")
  products StockProduct[]

  @@unique([organizationId, id])
  @@index([organizationId, parentId])
}

model StockBrand {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products StockProduct[]

  @@unique([organizationId, id])
}

/// Article du catalogue. Ses déclinaisons vendables sont ses variantes : un article sans déclinaison a une
/// seule variante, dite « par défaut », qui porte ses codes-barres (et plus tard ses stocks).
model StockProduct {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  /// Référence interne (SKU), unique par organisation ; générée si elle n'est pas saisie.
  sku            String
  name           String
  description    String?
  categoryId     String?  @db.Uuid
  brandId        String?  @db.Uuid
  /// Unité de vente (unité, kg, litre, carton…).
  unit           String   @default("unité")
  /// Prix de vente TTC.
  salePrice      Int
  /// Prix d'achat HT ; null s'il est inconnu (jamais estimé).
  purchasePrice  Int?
  vatRate        Int
  /// Seuil d'alerte (même unité) ; null = pas d'alerte.
  minStock       Decimal? @db.Decimal(14, 3)
  /// Faux pour un service ou un article qui ne se compte pas (aucun stock tenu).
  isStockable    Boolean  @default(true)
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category StockCategory?        @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  brand    StockBrand?           @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)
  variants StockVariant[]
  images   StockProductImage[]
  history  StockProductHistory[]

  @@unique([organizationId, id])
  @@unique([organizationId, sku])
  @@index([organizationId, isArchived, name])
  @@index([organizationId, categoryId])
  @@index([organizationId, brandId])
}

/// Déclinaison vendable d'un article (taille, couleur, contenance…). Prix propres facultatifs : à défaut,
/// ceux de l'article.
model StockVariant {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  productId      String   @db.Uuid
  /// Null pour la variante par défaut (article sans déclinaison).
  name           String?
  isDefault      Boolean  @default(false)
  /// Référence propre, unique par organisation (même espace que les références d'articles).
  sku            String
  salePrice      Int?
  purchasePrice  Int?
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product   StockProduct        @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  barcodes  StockBarcode[]
  levels    StockLevel[]
  movements StockMovement[]
  prices    StockPriceHistory[]

  @@unique([organizationId, id])
  @@unique([organizationId, sku])
  @@index([organizationId, productId])
}

/// Code-barres d'une variante, unique dans l'organisation.
model StockBarcode {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @db.Uuid
  variantId       String           @db.Uuid
  type            StockBarcodeType
  code            String
  createdByUserId String           @db.Uuid
  createdAt       DateTime         @default(now())

  variant StockVariant @relation(fields: [organizationId, variantId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, code])
  @@index([organizationId, variantId])
}

/// Photo d'un article : image réencodée en JPEG, sans métadonnées, clé de stockage privée.
model StockProductImage {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  productId       String   @db.Uuid
  storageKey      String
  position        Int
  bytes           Int
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now())

  product StockProduct @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  /// Quatre photos au plus : positions 0 à 3 (contrôle en base), chacune unique.
  @@unique([organizationId, productId, position])
}

/// Historique des prix d'une variante (ajout seul, garanti par la base).
model StockPriceHistory {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @db.Uuid
  variantId       String         @db.Uuid
  kind            StockPriceKind
  oldPrice        Int?
  newPrice        Int?
  changedByUserId String         @db.Uuid
  createdAt       DateTime       @default(now())

  variant StockVariant @relation(fields: [organizationId, variantId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, variantId, createdAt])
}

/// Historique des modifications d'un article (ajout seul, garanti par la base) : champs avant et après.
model StockProductHistory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  productId      String   @db.Uuid
  actorUserId    String   @db.Uuid
  action         String
  changes        Json
  createdAt      DateTime @default(now())

  product StockProduct @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, productId, createdAt])
}

/// Fournisseur (fiche). Commandes et réceptions : sprint S3.
model StockSupplier {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  contactName    String?
  phone          String?
  email          String?
  address        String?
  city           String?
  country        String   @default("ML") @db.Char(2)
  nif            String?
  /// Délai de livraison habituel, en jours ; null s'il est inconnu.
  leadTimeDays   Int?
  notes          String?
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  purchaseOrders StockPurchaseOrder[]
  returns        StockSupplierReturn[]
  prices         StockSupplierPrice[]

  @@unique([organizationId, id])
  @@index([organizationId, isArchived, name])
}

// ─── S2 : sites, emplacements, stocks, mouvements, transferts, inventaires ───

/// Type de site.
enum StockSiteKind {
  STORE
  DEPOT
  WAREHOUSE
}

/// Niveau d'un emplacement dans son site : zone, allée, rayonnage, emplacement. L'emplacement par défaut
/// d'un site (« Général ») sert quand le site n'est pas découpé.
enum StockLocationKind {
  DEFAULT
  ZONE
  AISLE
  SHELF
  BIN
}

/// Nature d'un mouvement de stock. Ventes, retours et réceptions fournisseurs s'ajoutent avec leurs sprints.
enum StockMovementKind {
  IN
  OUT
  ADJUSTMENT
  MOVE_OUT
  MOVE_IN
  TRANSFER_OUT
  TRANSFER_IN
  COUNT
  RECEIPT
  RECEIPT_CANCEL
  SUPPLIER_RETURN
  SALE
  SALE_RETURN
  /// S5 : demandes d'Ocall Facture (facture émise, pièces d'intervention signée, avoir avec retour).
  FACTURE_INVOICE
  FACTURE_PART
  FACTURE_CREDIT
}

enum StockTransferStatus {
  REQUESTED
  PREPARED
  SHIPPED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum StockCountStatus {
  OPEN
  VALIDATED
  CANCELLED
}

/// Inventaire complet (tout le périmètre : non compté = 0) ou partiel (seules les lignes comptées).
enum StockCountScope {
  FULL
  PARTIAL
}

/// Magasin, dépôt ou entrepôt.
model StockSite {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  /// Code court, unique par organisation (imprimé dans les QR codes des emplacements).
  code           String
  name           String
  kind           StockSiteKind
  address        String?
  city           String?
  isArchived     Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  locations     StockLocation[]
  members       StockMemberSite[]
  levels        StockLevel[]
  movements     StockMovement[]
  transfersFrom StockTransfer[]      @relation("StockTransferFrom")
  transfersTo   StockTransfer[]      @relation("StockTransferTo")
  counts        StockCount[]
  purchases     StockPurchaseOrder[]
  registers     StockRegister[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
}

/// Rattachement d'un membre à un site. Sans aucun rattachement, le membre agit sur tous les sites.
model StockMemberSite {
  organizationId String   @db.Uuid
  memberId       String   @db.Uuid
  siteId         String   @db.Uuid
  createdAt      DateTime @default(now())

  member StockMember @relation(fields: [organizationId, memberId], references: [organizationId, id], onDelete: Cascade)
  site   StockSite   @relation(fields: [organizationId, siteId], references: [organizationId, id], onDelete: Restrict)

  @@id([memberId, siteId])
  @@index([organizationId, siteId])
}

/// Emplacement physique d'un site (Zone A → Allée 01 → Rayon 03 → Emplacement A-01-03).
model StockLocation {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  siteId         String            @db.Uuid
  parentId       String?           @db.Uuid
  kind           StockLocationKind
  /// Code unique dans le site (A-01-03), lu dans le QR code de l'emplacement.
  code           String
  name           String
  isArchived     Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  site      StockSite       @relation(fields: [organizationId, siteId], references: [organizationId, id], onDelete: Restrict)
  parent    StockLocation?  @relation("StockLocationTree", fields: [organizationId, parentId], references: [organizationId, id], onDelete: Restrict)
  children  StockLocation[] @relation("StockLocationTree")
  levels    StockLevel[]
  movements StockMovement[]
  registers StockRegister[]
  /// Réglages qui en font l'emplacement des ventes Facture (S5).
  factureSettings StockSettings[] @relation("StockFactureLocation")

  @@unique([organizationId, id])
  @@unique([organizationId, siteId, code])
  @@index([organizationId, siteId, parentId])
}

/// Quantité d'une variante à un emplacement. Ne change que par un mouvement (même transaction, ligne
/// verrouillée). `reserved` : quantité préparée pour un transfert, pas encore expédiée.
model StockLevel {
  organizationId String   @db.Uuid
  variantId      String   @db.Uuid
  locationId     String   @db.Uuid
  siteId         String   @db.Uuid
  onHand         Decimal  @default(0) @db.Decimal(14, 3)
  reserved       Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt      DateTime @updatedAt

  variant  StockVariant  @relation(fields: [organizationId, variantId], references: [organizationId, id], onDelete: Restrict)
  location StockLocation @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  site     StockSite     @relation(fields: [organizationId, siteId], references: [organizationId, id], onDelete: Restrict)

  @@id([locationId, variantId])
  @@index([organizationId, siteId, variantId])
  @@index([organizationId, variantId])
}

/// Registre des mouvements : ajout seul (garanti par la base), quantité signée, quantité à l'emplacement
/// après le mouvement, opération source, clé d'idempotence (une même opération n'est jamais comptée deux
/// fois). Une correction est un mouvement compensatoire.
model StockMovement {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  variantId      String            @db.Uuid
  siteId         String            @db.Uuid
  locationId     String            @db.Uuid
  kind           StockMovementKind
  quantity       Decimal           @db.Decimal(14, 3)
  quantityAfter  Decimal           @db.Decimal(14, 3)
  /// Coût unitaire HT facultatif (entrée) ; jamais estimé.
  unitCost       Int?
  reason         String?
  /// Opération à l'origine : MANUAL, TRANSFER, COUNT (puis SALE, RECEIPT, FACTURE…).
  sourceType     String
  sourceId       String?           @db.Uuid
  idempotencyKey String
  actorUserId    String            @db.Uuid
  createdAt      DateTime          @default(now())

  variant  StockVariant  @relation(fields: [organizationId, variantId], references: [organizationId, id], onDelete: Restrict)
  site     StockSite     @relation(fields: [organizationId, siteId], references: [organizationId, id], onDelete: Restrict)
  location StockLocation @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, variantId, createdAt])
  @@index([organizationId, siteId, createdAt])
  @@index([organizationId, sourceType, sourceId])
}

/// Transfert entre deux sites : demandé → préparé (quantités réservées à la source) → expédié (sorties de
/// la source ; en transit) → reçu en une ou plusieurs fois (entrées à la destination), ou annulé avant
/// l'expédition. Un manque à la réception est déclaré et clôt la ligne.
model StockTransfer {
  id              String              @id @default(uuid()) @db.Uuid
  organizationId  String              @db.Uuid
  number          Int
  fromSiteId      String              @db.Uuid
  toSiteId        String              @db.Uuid
  status          StockTransferStatus @default(REQUESTED)
  note            String?
  createdByUserId String              @db.Uuid
  preparedAt      DateTime?
  shippedAt       DateTime?
  receivedAt      DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  fromSite StockSite           @relation("StockTransferFrom", fields: [organizationId, fromSiteId], references: [organizationId, id], onDelete: Restrict)
  toSite   StockSite           @relation("StockTransferTo", fields: [organizationId, toSiteId], references: [organizationId, id], onDelete: Restrict)
  lines    StockTransferLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, status])
}

model StockTransferLine {
  id               String  @id @default(uuid()) @db.Uuid
  organizationId   String  @db.Uuid
  transferId       String  @db.Uuid
  variantId        String  @db.Uuid
  quantity         Decimal @db.Decimal(14, 3)
  /// Emplacement de prélèvement, fixé à la préparation.
  fromLocationId   String? @db.Uuid
  shippedQuantity  Decimal @default(0) @db.Decimal(14, 3)
  receivedQuantity Decimal @default(0) @db.Decimal(14, 3)
  /// Manque déclaré à la réception (sorti de la source, jamais arrivé).
  lostQuantity     Decimal @default(0) @db.Decimal(14, 3)
  lossReason       String?

  transfer StockTransfer @relation(fields: [organizationId, transferId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([transferId, variantId])
  @@index([organizationId, variantId])
}

/// Inventaire d'un site (tout le site ou des emplacements choisis). L'écart est calculé à la validation :
/// ajustement = quantité comptée − stock au moment de la validation.
model StockCount {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @db.Uuid
  number            Int
  siteId            String           @db.Uuid
  scope             StockCountScope
  name              String
  /// Emplacements inventoriés ; vide = tout le site.
  locationIds       String[]         @db.Uuid
  status            StockCountStatus @default(OPEN)
  createdByUserId   String           @db.Uuid
  validatedByUserId String?          @db.Uuid
  validatedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  site  StockSite        @relation(fields: [organizationId, siteId], references: [organizationId, id], onDelete: Restrict)
  lines StockCountLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, status])
}

/// Quantité comptée d'une variante à un emplacement ; stock et écart figés à la validation.
model StockCountLine {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @db.Uuid
  countId            String   @db.Uuid
  variantId          String   @db.Uuid
  locationId         String   @db.Uuid
  countedQuantity    Decimal  @db.Decimal(14, 3)
  /// Stock au moment de la validation (null tant que l'inventaire est ouvert).
  expectedQuantity   Decimal? @db.Decimal(14, 3)
  /// Écart appliqué à la validation (compté − stock).
  differenceQuantity Decimal? @db.Decimal(14, 3)
  countedByUserId    String   @db.Uuid
  updatedAt          DateTime @updatedAt

  count StockCount @relation(fields: [organizationId, countId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([countId, locationId, variantId])
}

// ─── S3 : achats (commandes fournisseurs, réceptions, retours, prix d'achat, documents) ───

/// Commande fournisseur : brouillon (modifiable) → commandée (figée) → reçue en partie ou en totalité,
/// close (reste non attendu) ou annulée (avant toute réception).
enum StockPurchaseStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

/// Réception validée (entrées en stock) ou annulée (sorties compensatoires).
enum StockReceiptStatus {
  VALIDATED
  CANCELLED
}

/// Pièce à laquelle un document est joint.
enum StockDocumentOwner {
  PURCHASE_ORDER
  RECEIPT
  SUPPLIER_RETURN
}

model StockPurchaseOrder {
  id              String              @id @default(uuid()) @db.Uuid
  organizationId  String              @db.Uuid
  number          Int
  supplierId      String              @db.Uuid
  /// Site de livraison.
  siteId          String              @db.Uuid
  status          StockPurchaseStatus @default(DRAFT)
  /// Date de livraison attendue (indicative).
  expectedAt      DateTime?           @db.Date
  note            String?
  createdByUserId String              @db.Uuid
  orderedAt       DateTime?
  closedAt        DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  supplier StockSupplier       @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)
  site     StockSite           @relation(fields: [organizationId, siteId], references: [organizationId, id], onDelete: Restrict)
  lines    StockPurchaseLine[]
  receipts StockReceipt[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, supplierId])
}

model StockPurchaseLine {
  id               String  @id @default(uuid()) @db.Uuid
  organizationId   String  @db.Uuid
  orderId          String  @db.Uuid
  variantId        String  @db.Uuid
  quantity         Decimal @db.Decimal(14, 3)
  /// Coût unitaire HT convenu.
  unitCost         Int
  vatRate          Int
  receivedQuantity Decimal @default(0) @db.Decimal(14, 3)

  order        StockPurchaseOrder @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict)
  receiptLines StockReceiptLine[]

  @@unique([organizationId, id])
  @@unique([orderId, variantId])
  @@index([organizationId, variantId])
}

/// Réception d'une commande : une ou plusieurs par commande (livraisons partielles).
model StockReceipt {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @db.Uuid
  number            Int
  orderId           String             @db.Uuid
  siteId            String             @db.Uuid
  status            StockReceiptStatus @default(VALIDATED)
  /// Référence du bon de livraison du fournisseur.
  deliveryRef       String?
  /// Clé de l'appareil : une réception envoyée deux fois n'est enregistrée qu'une fois.
  idempotencyKey    String
  receivedByUserId  String             @db.Uuid
  cancelReason      String?
  cancelledByUserId String?            @db.Uuid
  cancelledAt       DateTime?
  createdAt         DateTime           @default(now())

  order StockPurchaseOrder @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict)
  lines StockReceiptLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, orderId])
}

/// Ligne reçue (ajout seul, garanti par la base) : quantité, emplacement de rangement, coût reçu.
model StockReceiptLine {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  receiptId      String  @db.Uuid
  orderLineId    String  @db.Uuid
  variantId      String  @db.Uuid
  locationId     String  @db.Uuid
  quantity       Decimal @db.Decimal(14, 3)
  unitCost       Int

  receipt   StockReceipt      @relation(fields: [organizationId, receiptId], references: [organizationId, id], onDelete: Restrict)
  orderLine StockPurchaseLine @relation(fields: [organizationId, orderLineId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([receiptId, orderLineId])
}

/// Retour de marchandise au fournisseur : sorties de stock tracées (ajout seul).
model StockSupplierReturn {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  number          Int
  supplierId      String   @db.Uuid
  siteId          String   @db.Uuid
  /// Commande d'origine, si elle est connue.
  orderId         String?  @db.Uuid
  reason          String
  idempotencyKey  String
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now())

  supplier StockSupplier             @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)
  lines    StockSupplierReturnLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, supplierId])
}

model StockSupplierReturnLine {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  returnId       String  @db.Uuid
  variantId      String  @db.Uuid
  locationId     String  @db.Uuid
  quantity       Decimal @db.Decimal(14, 3)

  supplierReturn StockSupplierReturn @relation(fields: [organizationId, returnId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([returnId, variantId, locationId])
}

/// Historique des prix d'achat par fournisseur et par variante (ajout seul) : un enregistrement par
/// ligne reçue.
model StockSupplierPrice {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  supplierId     String   @db.Uuid
  variantId      String   @db.Uuid
  unitCost       Int
  receiptId      String   @db.Uuid
  createdAt      DateTime @default(now())

  supplier StockSupplier @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, variantId, createdAt])
  @@index([organizationId, supplierId, createdAt])
}

/// Document joint à une commande, une réception ou un retour (bon de livraison, facture, photo) : fichier
/// vérifié, stockage privé.
model StockDocument {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @db.Uuid
  ownerType       StockDocumentOwner
  ownerId         String             @db.Uuid
  fileName        String
  mimeType        String
  bytes           Int
  storageKey      String
  createdByUserId String             @db.Uuid
  createdAt       DateTime           @default(now())

  @@unique([organizationId, id])
  @@index([organizationId, ownerType, ownerId])
}

// ─── S4 : caisse ───

/// Moyen de paiement saisi en caisse. Mobile money et carte sont saisis à la main : aucune confirmation
/// d'un prestataire n'est simulée.
enum StockPaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
  OTHER
}

enum StockCashSessionStatus {
  OPEN
  CLOSED
}

/// Connexion de l'imprimante de tickets d'une caisse (mêmes valeurs que le matériel Ocall Park).
enum StockPrinterConnection {
  NONE
  SIMULATED
  NETWORK
  BLUETOOTH
  USB
  WEBUSB
  WEBBLUETOOTH
}

/// Client d'un magasin (facultatif sur une vente). Rapproché des clients Ocall Facture au sprint S5.
model StockCustomer {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  phone          String?
  email          String?
  note           String?
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sales StockSale[]

  @@unique([organizationId, id])
  @@index([organizationId, isArchived, name])
  @@index([organizationId, phone])
}

/// Caisse d'un site : vend depuis un emplacement de ce site, imprime sur son imprimante de tickets.
model StockRegister {
  id                String                 @id @default(uuid()) @db.Uuid
  organizationId    String                 @db.Uuid
  siteId            String                 @db.Uuid
  /// Emplacement d'où sort la marchandise vendue (rayon, magasin).
  locationId        String                 @db.Uuid
  code              String
  name              String
  paperWidth        Int                    @default(80)
  printerConnection StockPrinterConnection @default(NONE)
  printerAddress    String?
  isArchived        Boolean                @default(false)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  site      StockSite          @relation(fields: [organizationId, siteId], references: [organizationId, id], onDelete: Restrict)
  location  StockLocation      @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  sessions  StockCashSession[]
  sales     StockSale[]
  heldCarts StockHeldCart[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, siteId])
}

/// Session de caisse : fond de caisse à l'ouverture ; à la clôture, espèces comptées, attendues et écart
/// (motif obligatoire s'il n'est pas nul). Une seule session ouverte par caisse (garanti par la base).
model StockCashSession {
  id               String                 @id @default(uuid()) @db.Uuid
  organizationId   String                 @db.Uuid
  number           Int
  registerId       String                 @db.Uuid
  siteId           String                 @db.Uuid
  status           StockCashSessionStatus @default(OPEN)
  openingFloat     Int
  openedByUserId   String                 @db.Uuid
  openedAt         DateTime               @default(now())
  expectedCash     Int?
  countedCash      Int?
  difference       Int?
  differenceReason String?
  closedByUserId   String?                @db.Uuid
  closedAt         DateTime?

  register StockRegister     @relation(fields: [organizationId, registerId], references: [organizationId, id], onDelete: Restrict)
  sales    StockSale[]
  returns  StockSaleReturn[]
  payments StockPayment[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, registerId, openedAt])
}

/// Vente encaissée : prix, remises, TVA et paiements figés à l'encaissement (le prix est lu dans le
/// catalogue par le serveur, jamais fourni par la caisse). Sortie de stock par le moteur, idempotente.
model StockSale {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  number         Int
  registerId     String   @db.Uuid
  sessionId      String   @db.Uuid
  siteId         String   @db.Uuid
  locationId     String   @db.Uuid
  customerId     String?  @db.Uuid
  cashierUserId  String   @db.Uuid
  /// Nom du caissier au moment de la vente (imprimé sur le ticket).
  cashierName    String
  /// Total TTC avant remises.
  grossTotal     Int
  discountTotal  Int
  /// Total TTC dû.
  total          Int
  vatTotal       Int
  /// Monnaie rendue (espèces).
  changeGiven    Int      @default(0)
  idempotencyKey String
  /// Réimpressions (duplicata) : seul champ qui change après l'encaissement.
  reprintCount   Int      @default(0)
  createdAt      DateTime @default(now())

  register StockRegister     @relation(fields: [organizationId, registerId], references: [organizationId, id], onDelete: Restrict)
  session  StockCashSession  @relation(fields: [organizationId, sessionId], references: [organizationId, id], onDelete: Restrict)
  customer StockCustomer?    @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  lines    StockSaleLine[]
  payments StockPayment[]
  returns  StockSaleReturn[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([organizationId, sessionId])
  @@index([organizationId, customerId])
}

/// Ligne de vente : instantané de l'article (référence, libellé, prix TTC, TVA). Seuls la quantité et le
/// montant retournés évoluent (retours).
model StockSaleLine {
  id               String  @id @default(uuid()) @db.Uuid
  organizationId   String  @db.Uuid
  saleId           String  @db.Uuid
  variantId        String  @db.Uuid
  sku              String
  label            String
  isStockable      Boolean
  quantity         Decimal @db.Decimal(14, 3)
  unitPrice        Int
  vatRate          Int
  discount         Int     @default(0)
  /// Montant TTC de la ligne après remise.
  total            Int
  vatAmount        Int
  returnedQuantity Decimal @default(0) @db.Decimal(14, 3)
  refundedAmount   Int     @default(0)

  sale StockSale @relation(fields: [organizationId, saleId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, saleId])
  @@index([organizationId, variantId])
}

/// Paiement d'une vente (positif) ou remboursement d'un retour (négatif). Mobile money et carte : saisis à
/// la main, la référence est celle donnée par le client ou le terminal.
model StockPayment {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  saleId         String             @db.Uuid
  sessionId      String             @db.Uuid
  returnId       String?            @db.Uuid
  method         StockPaymentMethod
  amount         Int
  /// Espèces : somme remise par le client (la monnaie rendue est la différence).
  tendered       Int?
  reference      String?
  createdAt      DateTime           @default(now())

  sale    StockSale        @relation(fields: [organizationId, saleId], references: [organizationId, id], onDelete: Restrict)
  session StockCashSession @relation(fields: [organizationId, sessionId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, saleId])
  @@index([organizationId, sessionId])
}

/// Retour en caisse : marchandise rendue (remise en stock ou non), remboursée dans une session ouverte.
model StockSaleReturn {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @db.Uuid
  number          Int
  saleId          String             @db.Uuid
  sessionId       String             @db.Uuid
  reason          String
  /// Faux : marchandise défectueuse, non remise en stock.
  restock         Boolean
  refundMethod    StockPaymentMethod
  refundAmount    Int
  idempotencyKey  String
  createdByUserId String             @db.Uuid
  createdAt       DateTime           @default(now())

  sale    StockSale             @relation(fields: [organizationId, saleId], references: [organizationId, id], onDelete: Restrict)
  session StockCashSession      @relation(fields: [organizationId, sessionId], references: [organizationId, id], onDelete: Restrict)
  lines   StockSaleReturnLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, saleId])
}

model StockSaleReturnLine {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  returnId       String  @db.Uuid
  saleLineId     String  @db.Uuid
  variantId      String  @db.Uuid
  quantity       Decimal @db.Decimal(14, 3)
  amount         Int

  saleReturn StockSaleReturn @relation(fields: [organizationId, returnId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, returnId])
}

/// Panier mis en attente sur une caisse (client parti chercher un article…) ; supprimé à la reprise.
model StockHeldCart {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  registerId      String   @db.Uuid
  label           String
  /// Lignes { variantId, quantity, discount } et client facultatif : les prix sont relus à l'encaissement.
  payload         Json
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now())

  register StockRegister @relation(fields: [organizationId, registerId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, registerId, createdAt])
}

// ─── S5 — Interconnexion Ocall Facture ───

/// Demande de mouvement reçue d'une autre application (Ocall Facture) et appliquée : une par clé, jamais
/// deux (la clé est celle de la file de sortie de Facture). Trace de ce qui a été déstocké, pour quel
/// document, et rejeu sans effet. Jamais modifiée ni supprimée (contrôlé par la base).
model StockInboundEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  /// Application émettrice (FACTURE).
  origin         String
  /// Clé unique de la demande (« facture-invoice:<document> », « facture-part:<intervention> »…).
  key            String
  /// Nature de la demande : INVOICE, INTERVENTION, CREDIT_NOTE.
  source         String
  /// Document ou intervention d'origine, dans l'application émettrice.
  sourceId       String   @db.Uuid
  /// Numéro lisible du document d'origine (FAC-2026-00012, INT-2026-00003).
  reference      String
  locationId     String   @db.Uuid
  /// Lignes appliquées : [{ variantId, quantity }] (quantité signée).
  lines          Json
  actorUserId    String   @db.Uuid
  createdAt      DateTime @default(now())

  @@unique([organizationId, id])
  @@unique([organizationId, key])
  @@index([organizationId, createdAt])
  @@index([organizationId, source, sourceId])
}
