// Ocall Park — schéma Sprint 1 (socle SaaS multi-tenant).
// Toute ressource métier porte un organizationId : c'est la clé d'isolation des tenants.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum BusinessType {
  PARK
  RESTAURANT
  PARK_RESTAURANT
}

enum MemberRole {
  OWNER
  ADMIN
  SUPERVISOR
  CASHIER
  KITCHEN
  GATE_AGENT
}

enum PlatformRole {
  SUPER_ADMIN
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  NOT_ACTIVATED
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELED
}

enum SubscriptionEventType {
  CREATED
  PLAN_CHANGED
  STATUS_CHANGED
}

model Organization {
  id           String             @id @default(uuid()) @db.Uuid
  name         String
  /// Code court unique, préfixe des identifiants employés (ex. AQUA → AQUA-0001).
  code         String             @unique
  businessType BusinessType
  countryCode  String             @default("ML") @db.Char(2)
  currency     String             @default("XOF") @db.Char(3)
  timezone     String             @default("Africa/Bamako")
  status       OrganizationStatus @default(ACTIVE)
  /// Compteur des identifiants employés, incrémenté de façon atomique.
  employeeSeq  Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  establishments   Establishment[]
  memberships      OrganizationMembership[]
  assignments      EstablishmentAssignment[]
  subscription     Subscription?
  auditLogs        AuditLog[]
  categories       ProductCategory[]
  products         Product[]
  variants         ProductVariant[]
  variantPrices    VariantPrice[]
  cashSessions     CashSession[]
  sales            Sale[]
  saleLines        SaleLine[]
  payments         Payment[]
  posTerminals     PosTerminal[]
  printJobs        PrintJob[]
  drawerEvents     DrawerEvent[]
  ticketCategories TicketCategory[]
  tickets          Ticket[]
  ticketScans      TicketScan[]
  parkSchedules    ParkOpeningSchedule[]
  parkExceptions   ParkCalendarException[]
  orderEvents      OrderEvent[]
  diningZones      DiningZone[]
  diningTables     DiningTable[]
  qrOrderRequests  QrOrderRequest[]
  stockItems       StockItem[]
  stockMovements   StockMovement[]
  recipeComponents RecipeComponent[]
  reservations     Reservation[]

  @@index([status])
  @@index([businessType])
}

model Establishment {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  /// Activité(s) exercée(s), toujours compatible(s) avec le métier de l'organisation.
  businessType   BusinessType
  city           String?
  address        String?
  phone          String?
  timezone       String       @default("Africa/Bamako")
  isActive       Boolean      @default(true)
  /// Compteur des numéros de vente de l'établissement, incrémenté de façon atomique.
  saleSeq        Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments      EstablishmentAssignment[]
  variantPrices    VariantPrice[]
  cashSessions     CashSession[]
  sales            Sale[]
  posTerminals     PosTerminal[]
  printJobs        PrintJob[]
  drawerEvents     DrawerEvent[]
  ticketCategories TicketCategory[]
  tickets          Ticket[]
  ticketScans      TicketScan[]
  parkSchedules    ParkOpeningSchedule[]
  parkExceptions   ParkCalendarException[]
  orderEvents      OrderEvent[]
  diningZones      DiningZone[]
  diningTables     DiningTable[]
  qrOrderRequests  QrOrderRequest[]
  stockItems       StockItem[]
  stockMovements   StockMovement[]
  reservations     Reservation[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model User {
  id                 String        @id @default(uuid()) @db.Uuid
  firstName          String
  lastName           String
  /// Facultatif pour les employés ; stocké en minuscules.
  email              String?       @unique
  /// Identifiant de connexion individuel unique (ex. AQUA-0001).
  loginId            String        @unique
  passwordHash       String
  mustChangePassword Boolean       @default(true)
  platformRole       PlatformRole?
  isActive           Boolean       @default(true)
  failedLoginCount   Int           @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  memberships         OrganizationMembership[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
}

model OrganizationMembership {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  userId         String     @db.Uuid
  role           MemberRole
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments  EstablishmentAssignment[]
  sessions     Session[]

  cashSessionsOpened CashSession[]    @relation("CashSessionOpenedBy")
  cashSessionsClosed CashSession[]    @relation("CashSessionClosedBy")
  sales              Sale[]           @relation("SaleCashier")
  salesCancelled     Sale[]           @relation("SaleCancelledBy")
  paymentsReceived   Payment[]        @relation("PaymentReceivedBy")
  printJobs          PrintJob[]       @relation("PrintJobRequestedBy")
  drawerEvents       DrawerEvent[]    @relation("DrawerEventRequestedBy")
  ticketScans        TicketScan[]     @relation("TicketScanAgent")
  ticketsCancelled   Ticket[]         @relation("TicketCancelledBy")
  orderEvents        OrderEvent[]     @relation("OrderEventActor")
  qrOrdersDecided    QrOrderRequest[] @relation("QrOrderDecidedBy")
  stockMovements     StockMovement[]  @relation("StockMovementActor")
  reservationsMade   Reservation[]    @relation("ReservationCreatedBy")

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role, isActive])
}

model EstablishmentAssignment {
  id              String   @id @default(uuid()) @db.Uuid
  /// Dénormalisé pour filtrer toutes les requêtes par tenant.
  organizationId  String   @db.Uuid
  membershipId    String   @db.Uuid
  establishmentId String   @db.Uuid
  createdAt       DateTime @default(now())

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership    OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  establishment Establishment          @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@unique([membershipId, establishmentId])
  @@index([organizationId])
  @@index([establishmentId])
}

/// Session opaque : seul le hash SHA-256 du jeton est stocké.
model Session {
  id           String    @id @default(uuid()) @db.Uuid
  tokenHash    String    @unique
  userId       String    @db.Uuid
  /// Organisation active de la session ; null pour un SUPER_ADMIN.
  membershipId String?   @db.Uuid
  expiresAt    DateTime
  lastSeenAt   DateTime  @default(now())
  revokedAt    DateTime?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership OrganizationMembership? @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Jeton de réinitialisation : hashé, à usage unique, à durée limitée.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Offres commerciales. Les prix ne vivent qu'ici et sont modifiables par le Super Admin.
model SubscriptionPlan {
  id           String       @id @default(uuid()) @db.Uuid
  businessType BusinessType @unique
  name         String
  monthlyPrice Int
  currency     String       @default("XOF") @db.Char(3)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @unique @db.Uuid
  planId         String             @db.Uuid
  status         SubscriptionStatus @default(NOT_ACTIVATED)
  startedAt      DateTime?
  expiresAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan    @relation(fields: [planId], references: [id])
  events       SubscriptionEvent[]

  @@index([status])
}

/// Historique des changements d'abonnement.
model SubscriptionEvent {
  id             String                @id @default(uuid()) @db.Uuid
  subscriptionId String                @db.Uuid
  type           SubscriptionEventType
  fromPlanId     String?               @db.Uuid
  toPlanId       String?               @db.Uuid
  fromStatus     SubscriptionStatus?
  toStatus       SubscriptionStatus?
  actorUserId    String?               @db.Uuid
  reason         String?
  createdAt      DateTime              @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
}

/// Journal d'audit en ajout seul. organizationId null = action plateforme.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  actorUserId    String?  @db.Uuid
  action         String
  targetType     String
  targetId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([actorUserId])
}

// ─── Sprint 2 : catalogue, caisse POS, ventes et paiements ───

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum SaleActivity {
  RESTAURANT
  PARK
}

enum SaleStatus {
  OPEN
  CANCELLED
}

/// Statut de paiement, indépendant du statut de préparation.
enum SalePaymentStatus {
  UNPAID
  PAID
}

/// Statut de préparation cuisine. Un paiement ne le modifie JAMAIS : seul l'envoi explicite
/// en cuisine (« Envoyer en cuisine ») le fait quitter NOT_SENT.
enum PreparationStatus {
  NOT_SENT
  SENT
  IN_PREPARATION
  READY
  SERVED
}

/// Canal de commande d'une vente de restaurant.
enum OrderChannel {
  DINE_IN
  TAKEAWAY
  COUNTER
  QR
}

enum PaymentMethod {
  CASH
  WAVE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model ProductCategory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model Product {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  categoryId     String   @db.Uuid
  name           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     ProductCategory  @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  variants     ProductVariant[]

  @@unique([organizationId, name])
  @@index([organizationId, categoryId])
}

/// Déclinaison vendable d'un produit (ex. « Standard », « Grand modèle »). Tout produit en a au moins une.
/// Une variante utilisée par une vente n'est jamais supprimée : elle est désactivée.
model ProductVariant {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  productId      String   @db.Uuid
  name           String
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  prices       VariantPrice[]
  saleLines    SaleLine[]
  recipes      RecipeComponent[]

  @@unique([productId, name])
  @@index([organizationId])
}

/// Tarif d'une variante dans un établissement (montant entier en FCFA, TTC).
model VariantPrice {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  variantId       String   @db.Uuid
  establishmentId String   @db.Uuid
  price           Int
  isAvailable     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  establishment Establishment  @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@unique([variantId, establishmentId])
  @@index([organizationId, establishmentId])
}

/// Session de caisse d'un employé dans un établissement : fond de caisse, espèces attendues,
/// espèces comptées et écart à la fermeture.
model CashSession {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @db.Uuid
  establishmentId String            @db.Uuid
  openedById      String            @db.Uuid
  status          CashSessionStatus @default(OPEN)
  openingFloat    Int
  openedAt        DateTime          @default(now())
  closedById      String?           @db.Uuid
  closedAt        DateTime?
  expectedCash    Int?
  countedCash     Int?
  /// countedCash - expectedCash : négatif = manque, positif = excédent.
  variance        Int?
  closingNote     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  establishment Establishment           @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  openedBy      OrganizationMembership  @relation("CashSessionOpenedBy", fields: [openedById], references: [id], onDelete: NoAction)
  closedBy      OrganizationMembership? @relation("CashSessionClosedBy", fields: [closedById], references: [id], onDelete: NoAction)
  sales         Sale[]
  payments      Payment[]

  @@index([organizationId, establishmentId, status])
  @@index([openedById, status])
}

model Sale {
  id                   String            @id @default(uuid()) @db.Uuid
  organizationId       String            @db.Uuid
  establishmentId      String            @db.Uuid
  cashSessionId        String            @db.Uuid
  cashierId            String            @db.Uuid
  /// Numéro séquentiel par établissement.
  number               Int
  /// Restaurant (caisse) ou parc (billetterie) : même moteur de vente et de paiement.
  activity             SaleActivity      @default(RESTAURANT)
  status               SaleStatus        @default(OPEN)
  paymentStatus        SalePaymentStatus @default(UNPAID)
  preparationStatus    PreparationStatus @default(NOT_SENT)
  /// Total TTC en FCFA, calculé par le serveur à partir des tarifs de l'établissement.
  total                Int
  /// Clé d'idempotence fournie par la caisse : une nouvelle tentative ne crée pas de doublon.
  clientRequestId      String?
  cancelledAt          DateTime?
  cancelledById        String?           @db.Uuid
  /// Restaurant : canal de commande (null pour la billetterie et les ventes antérieures au Sprint 5).
  channel              OrderChannel?
  tableId              String?           @db.Uuid
  zoneId               String?           @db.Uuid
  /// Instructions de préparation pour toute la commande.
  notes                String?
  /// Horodatage du cycle de préparation (temps d'attente et de préparation).
  sentToKitchenAt      DateTime?
  preparationStartedAt DateTime?
  readyAt              DateTime?
  servedAt             DateTime?
  /// Déduction des ingrédients réalisée (une seule fois par vente : envoi en cuisine ou paiement).
  stockDeductedAt      DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  establishment  Establishment           @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  cashSession    CashSession             @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  cashier        OrganizationMembership  @relation("SaleCashier", fields: [cashierId], references: [id], onDelete: NoAction)
  cancelledBy    OrganizationMembership? @relation("SaleCancelledBy", fields: [cancelledById], references: [id], onDelete: NoAction)
  table          DiningTable?            @relation(fields: [tableId], references: [id], onDelete: NoAction)
  zone           DiningZone?             @relation(fields: [zoneId], references: [id], onDelete: NoAction)
  lines          SaleLine[]
  payments       Payment[]
  printJobs      PrintJob[]
  tickets        Ticket[]
  events         OrderEvent[]
  qrRequest      QrOrderRequest?
  stockMovements StockMovement[]

  @@unique([establishmentId, number])
  @@unique([organizationId, clientRequestId])
  @@index([organizationId, createdAt])
  @@index([cashSessionId])
  @@index([cashierId, createdAt])
  @@index([establishmentId, preparationStatus])
  @@index([tableId])
}

/// Ligne de vente : libellés et prix figés au moment de la vente.
model SaleLine {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @db.Uuid
  saleId           String   @db.Uuid
  /// Article de restaurant (null pour une ligne de billetterie).
  variantId        String?  @db.Uuid
  /// Catégorie de billet (null pour une ligne de restaurant).
  ticketCategoryId String?  @db.Uuid
  productName      String
  variantName      String
  unitPrice        Int
  quantity         Int
  lineTotal        Int
  /// Billetterie : nombre de billets individuels par unité (1, ou 5 pour une formule famille de 5).
  peoplePerUnit    Int      @default(1)
  /// Billetterie : prénoms des visiteurs, un par billet individuel, saisis avant le paiement.
  visitorNames     String[] @default([])
  /// Restaurant : instruction de préparation de la ligne (ex. « sans oignon »).
  notes            String?
  /// Rang de la ligne dans la saisie : ordre stable des tickets, billets et écrans (0 pour les
  /// lignes antérieures, alors départagées par identifiant).
  lineNo           Int      @default(0)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale           Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: NoAction)
  ticketCategory TicketCategory? @relation(fields: [ticketCategoryId], references: [id], onDelete: NoAction)
  tickets        Ticket[]

  @@index([saleId])
  @@index([organizationId])
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @db.Uuid
  saleId            String        @db.Uuid
  cashSessionId     String        @db.Uuid
  receivedById      String        @db.Uuid
  method            PaymentMethod
  status            PaymentStatus
  amount            Int
  /// Espèces remises par le client (paiement en espèces uniquement).
  amountTendered    Int?
  changeGiven       Int?
  /// Référence du prestataire (Wave), renseignée uniquement par une notification vérifiée.
  providerReference String?
  clientRequestId   String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale         Sale                   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  cashSession  CashSession            @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  receivedBy   OrganizationMembership @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: NoAction)
  drawerEvent  DrawerEvent?

  @@unique([organizationId, clientRequestId])
  @@index([saleId])
  @@index([cashSessionId, method, status])
}

// ─── Sprint 3 : postes de caisse, impression thermique et tiroir-caisse ───

enum PrinterConnection {
  NONE
  SIMULATED
  NETWORK
  BLUETOOTH
  USB
}

enum PrintJobKind {
  RECEIPT
  REPRINT
  TEST
  /// Ticket cuisine (sans prix), après l'envoi explicite en cuisine.
  KITCHEN
}

enum HardwareJobStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum DrawerOpenReason {
  CASH_PAYMENT
  MANUAL
}

/// Poste de caisse (tablette) d'un établissement, avec son imprimante et son tiroir-caisse.
model PosTerminal {
  id                String            @id @default(uuid()) @db.Uuid
  organizationId    String            @db.Uuid
  establishmentId   String            @db.Uuid
  name              String
  isActive          Boolean           @default(true)
  printerConnection PrinterConnection @default(NONE)
  /// Réseau : IPv4 locale[:port] ; Bluetooth : adresse MAC ; USB : vendorId:productId.
  printerAddress    String?
  /// Largeur du papier en mm : 58 ou 80.
  paperWidth        Int               @default(80)
  autoPrintReceipt  Boolean           @default(true)
  drawerEnabled     Boolean           @default(false)
  /// Broche du connecteur de tiroir (2 ou 5).
  drawerPin         Int               @default(2)
  /// Imprimante de la cuisine : reçoit les tickets cuisine de l'établissement.
  kitchenPrinter    Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  printJobs     PrintJob[]
  drawerEvents  DrawerEvent[]

  @@unique([establishmentId, name])
  @@index([organizationId, establishmentId])
}

/// Tentative d'impression : chaque essai est historisé. Une impression ne modifie jamais la vente.
model PrintJob {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @db.Uuid
  establishmentId String            @db.Uuid
  terminalId      String            @db.Uuid
  saleId          String?           @db.Uuid
  /// Réimpression d'un seul billet (null = toute la vente).
  ticketId        String?           @db.Uuid
  kind            PrintJobKind
  status          HardwareJobStatus @default(PENDING)
  paperWidth      Int
  reason          String?
  errorCode       String?
  errorMessage    String?
  requestedById   String            @db.Uuid
  clientRequestId String?
  createdAt       DateTime          @default(now())
  completedAt     DateTime?

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  establishment Establishment          @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  terminal      PosTerminal            @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  sale          Sale?                  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  requestedBy   OrganizationMembership @relation("PrintJobRequestedBy", fields: [requestedById], references: [id], onDelete: NoAction)

  @@unique([organizationId, clientRequestId])
  @@index([saleId])
  @@index([terminalId, createdAt])
}

/// Ouverture du tiroir-caisse : automatique (une seule fois par paiement en espèces) ou manuelle justifiée.
model DrawerEvent {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @db.Uuid
  establishmentId String            @db.Uuid
  terminalId      String            @db.Uuid
  reason          DrawerOpenReason
  /// Unique : un paiement ne peut ouvrir le tiroir qu'une seule fois.
  paymentId       String?           @unique @db.Uuid
  justification   String?
  status          HardwareJobStatus @default(PENDING)
  errorCode       String?
  errorMessage    String?
  requestedById   String            @db.Uuid
  clientRequestId String?
  createdAt       DateTime          @default(now())
  completedAt     DateTime?

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  establishment Establishment          @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  terminal      PosTerminal            @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  payment       Payment?               @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  requestedBy   OrganizationMembership @relation("DrawerEventRequestedBy", fields: [requestedById], references: [id], onDelete: NoAction)

  @@unique([organizationId, clientRequestId])
  @@index([terminalId, createdAt])
}

// ─── Sprint 4 : billetterie Parc, QR codes et contrôle d'accès ───

enum TicketKind {
  ADULT
  CHILD
  FAMILY
  GROUP
  CUSTOM
}

enum TicketStatus {
  VALID
  USED
  EXPIRED
  CANCELLED
}

enum TicketScanResult {
  ACCEPTED
  REFUSED
}

enum TicketScanRefusal {
  ALREADY_USED
  EXPIRED
  CANCELLED
  UNKNOWN
  OTHER_ESTABLISHMENT
  PARK_CLOSED
  NOT_YET_VALID
}

/// Catégorie de billet d'un établissement (Adulte, Enfant, Famille…). Jamais supprimée : désactivée.
model TicketCategory {
  id              String     @id @default(uuid()) @db.Uuid
  organizationId  String     @db.Uuid
  establishmentId String     @db.Uuid
  kind            TicketKind
  name            String
  description     String?
  /// Prix TTC en FCFA d'une unité (une formule famille compte pour une unité).
  price           Int
  /// Nombre de billets individuels émis par unité vendue (famille de 5 = 5).
  peopleIncluded  Int        @default(1)
  conditions      String?
  /// Fenêtre de vente (dates locales incluses) ; null = sans limite.
  availableFrom   DateTime?  @db.Date
  availableUntil  DateTime?  @db.Date
  /// Durée de validité d'un billet, en jours à compter du jour de la visite.
  validityDays    Int        @default(1)
  sortOrder       Int        @default(0)
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  saleLines     SaleLine[]
  tickets       Ticket[]

  @@unique([establishmentId, name])
  @@index([organizationId, establishmentId, isActive])
}

/// Billet individuel émis après paiement confirmé. Le QR code ne contient que le jeton.
model Ticket {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @db.Uuid
  establishmentId  String       @db.Uuid
  saleId           String       @db.Uuid
  saleLineId       String       @db.Uuid
  ticketCategoryId String       @db.Uuid
  /// Rang du billet dans la ligne de vente : garantit qu'une émission n'est jamais faite deux fois.
  position         Int
  visitorName      String
  /// Jeton aléatoire de 128 bits (base64url) : seul contenu du QR code.
  token            String       @unique
  status           TicketStatus @default(VALID)
  /// Part du prix payé attribuée à ce billet (FCFA).
  pricePaid        Int
  validFrom        DateTime
  validUntil       DateTime
  usedAt           DateTime?
  cancelledAt      DateTime?
  cancelledById    String?      @db.Uuid
  cancelReason     String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  establishment  Establishment           @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  sale           Sale                    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleLine       SaleLine                @relation(fields: [saleLineId], references: [id], onDelete: Cascade)
  ticketCategory TicketCategory          @relation(fields: [ticketCategoryId], references: [id], onDelete: NoAction)
  cancelledBy    OrganizationMembership? @relation("TicketCancelledBy", fields: [cancelledById], references: [id], onDelete: NoAction)
  scans          TicketScan[]            @relation("TicketScans")
  acceptedScan   TicketScan?             @relation("TicketAcceptedScan")

  @@unique([saleLineId, position])
  @@index([organizationId, establishmentId, createdAt])
  @@index([saleId])
  @@index([establishmentId, status, validUntil])
}

/// Passage au contrôle d'accès, accepté ou refusé (historique complet des scans).
model TicketScan {
  id                  String             @id @default(uuid()) @db.Uuid
  organizationId      String             @db.Uuid
  /// Établissement du point de contrôle (celui de l'agent).
  establishmentId     String             @db.Uuid
  /// Billet reconnu (null si inconnu ou d'une autre organisation).
  ticketId            String?            @db.Uuid
  /// Renseigné uniquement pour un scan accepté : unique, une seule entrée par billet en base.
  acceptedForTicketId String?            @unique @db.Uuid
  result              TicketScanResult
  refusalReason       TicketScanRefusal?
  entryPoint          String
  scannedById         String             @db.Uuid
  clientRequestId     String?
  createdAt           DateTime           @default(now())

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  establishment  Establishment          @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  ticket         Ticket?                @relation("TicketScans", fields: [ticketId], references: [id], onDelete: Cascade)
  acceptedTicket Ticket?                @relation("TicketAcceptedScan", fields: [acceptedForTicketId], references: [id], onDelete: Cascade)
  scannedBy      OrganizationMembership @relation("TicketScanAgent", fields: [scannedById], references: [id], onDelete: NoAction)

  @@unique([organizationId, clientRequestId])
  @@index([establishmentId, createdAt])
  @@index([ticketId])
}

/// Horaire hebdomadaire du parc (n'affecte jamais le restaurant d'un établissement mixte).
model ParkOpeningSchedule {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  establishmentId String   @db.Uuid
  /// 0 = dimanche … 6 = samedi.
  weekday         Int
  isClosed        Boolean  @default(false)
  /// « HH:MM », heure locale de l'établissement.
  opensAt         String?
  closesAt        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@unique([establishmentId, weekday])
  @@index([organizationId])
}

/// Date particulière : fermeture exceptionnelle, horaires spéciaux, créneau ou évènement.
model ParkCalendarException {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  establishmentId String   @db.Uuid
  date            DateTime @db.Date
  isClosed        Boolean  @default(false)
  opensAt         String?
  closesAt        String?
  label           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@unique([establishmentId, date])
  @@index([organizationId])
}

// ─── Sprint 5 : restaurant — commandes, cuisine, QR, tables, stocks, réservations ───

/// Historique d'une commande de restaurant : création, modification, envoi en cuisine, préparation,
/// service, paiement, annulation. En ajout seul.
model OrderEvent {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @db.Uuid
  establishmentId   String             @db.Uuid
  saleId            String             @db.Uuid
  /// created, updated, sent_to_kitchen, preparation_started, ready, served, paid, cancelled, qr_accepted
  type              String
  fromStatus        PreparationStatus?
  toStatus          PreparationStatus?
  actorMembershipId String?            @db.Uuid
  metadata          Json?
  createdAt         DateTime           @default(now())

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  establishment Establishment           @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  sale          Sale                    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  actor         OrganizationMembership? @relation("OrderEventActor", fields: [actorMembershipId], references: [id], onDelete: NoAction)

  @@index([saleId, createdAt])
  @@index([organizationId, createdAt])
}

enum DiningZoneKind {
  ROOM
  TERRACE
  POOLSIDE
  CUSTOM
}

/// Zone de service (salle, terrasse, bord de piscine…). Facultative : un restaurant peut n'en avoir aucune.
model DiningZone {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @db.Uuid
  establishmentId String         @db.Uuid
  name            String
  kind            DiningZoneKind @default(ROOM)
  sortOrder       Int            @default(0)
  isActive        Boolean        @default(true)
  /// Jeton aléatoire de 128 bits du QR code de zone (commande sans table précise).
  qrToken         String         @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  establishment Establishment    @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  tables        DiningTable[]
  sales         Sale[]
  qrRequests    QrOrderRequest[]
  reservations  Reservation[]

  @@unique([establishmentId, name])
  @@index([organizationId])
}

model DiningTable {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  establishmentId String   @db.Uuid
  zoneId          String?  @db.Uuid
  name            String
  seats           Int      @default(4)
  /// false = hors service : aucune commande QR ni réservation.
  isActive        Boolean  @default(true)
  /// Jeton aléatoire de 128 bits du QR code de table : seul contenu de l'URL publique.
  qrToken         String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  establishment Establishment    @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  zone          DiningZone?      @relation(fields: [zoneId], references: [id], onDelete: NoAction)
  sales         Sale[]
  qrRequests    QrOrderRequest[]
  reservations  Reservation[]

  @@unique([establishmentId, name])
  @@index([organizationId])
  @@index([zoneId])
}

enum QrOrderStatus {
  PENDING_VALIDATION
  ACCEPTED
  REJECTED
}

/// Demande de commande envoyée par un client depuis un QR code. Elle n'est ni payée ni envoyée en
/// cuisine : un employé la valide (elle devient alors une vente non payée, non envoyée) ou la refuse.
model QrOrderRequest {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @db.Uuid
  establishmentId String        @db.Uuid
  tableId         String?       @db.Uuid
  zoneId          String?       @db.Uuid
  /// Jeton aléatoire remis au client pour suivre sa demande (aucun compte requis).
  publicToken     String        @unique
  status          QrOrderStatus @default(PENDING_VALIDATION)
  customerName    String?
  notes           String?
  /// Lignes demandées (variante, quantité, instruction) avec libellés et prix indicatifs du moment.
  lines           Json
  /// Total indicatif calculé par le serveur ; la vente est revalorisée à la validation.
  estimatedTotal  Int
  /// Clé d'idempotence générée par la page du client : un double envoi ne crée pas de doublon.
  clientRequestId String
  rejectedReason  String?
  decidedById     String?       @db.Uuid
  decidedAt       DateTime?
  saleId          String?       @unique @db.Uuid
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  establishment Establishment           @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  table         DiningTable?            @relation(fields: [tableId], references: [id], onDelete: NoAction)
  zone          DiningZone?             @relation(fields: [zoneId], references: [id], onDelete: NoAction)
  decidedBy     OrganizationMembership? @relation("QrOrderDecidedBy", fields: [decidedById], references: [id], onDelete: NoAction)
  sale          Sale?                   @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@unique([establishmentId, clientRequestId])
  @@index([establishmentId, status, createdAt])
  @@index([tableId, status])
  @@index([zoneId, status])
}

enum StockUnit {
  UNIT
  G
  KG
  ML
  CL
  L
}

enum StockMovementKind {
  IN
  OUT
  ADJUSTMENT
  SALE
}

/// Article ou ingrédient en stock dans un établissement.
model StockItem {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @db.Uuid
  establishmentId String    @db.Uuid
  name            String
  unit            StockUnit
  quantity        Decimal   @default(0) @db.Decimal(14, 3)
  /// Seuil d'alerte (même unité) ; null = pas d'alerte.
  alertThreshold  Decimal?  @db.Decimal(14, 3)
  /// Coût d'achat unitaire facultatif (FCFA) ; jamais estimé s'il est inconnu.
  unitCost        Int?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  establishment Establishment     @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  movements     StockMovement[]
  recipes       RecipeComponent[]

  @@unique([establishmentId, name])
  @@index([organizationId, establishmentId, isActive])
}

/// Mouvement de stock en ajout seul. La clé d'idempotence empêche toute double déduction.
model StockMovement {
  id                String            @id @default(uuid()) @db.Uuid
  organizationId    String            @db.Uuid
  establishmentId   String            @db.Uuid
  stockItemId       String            @db.Uuid
  kind              StockMovementKind
  /// Variation signée (positive = entrée, négative = sortie).
  quantity          Decimal           @db.Decimal(14, 3)
  quantityAfter     Decimal           @db.Decimal(14, 3)
  unitCost          Int?
  reason            String?
  saleId            String?           @db.Uuid
  actorMembershipId String?           @db.Uuid
  /// « sale:<vente>:<article> » pour une vente, « req:<clé client> » pour une saisie.
  idempotencyKey    String
  createdAt         DateTime          @default(now())

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  establishment Establishment           @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  stockItem     StockItem               @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  sale          Sale?                   @relation(fields: [saleId], references: [id], onDelete: SetNull)
  actor         OrganizationMembership? @relation("StockMovementActor", fields: [actorMembershipId], references: [id], onDelete: NoAction)

  @@unique([organizationId, idempotencyKey])
  @@index([stockItemId, createdAt])
  @@index([saleId])
}

/// Recette simple : quantité d'un ingrédient consommée par unité vendue d'une variante.
model RecipeComponent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  variantId      String   @db.Uuid
  stockItemId    String   @db.Uuid
  quantity       Decimal  @db.Decimal(14, 3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  stockItem    StockItem      @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@unique([variantId, stockItemId])
  @@index([organizationId])
  @@index([stockItemId])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Reservation {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @db.Uuid
  establishmentId String            @db.Uuid
  tableId         String?           @db.Uuid
  zoneId          String?           @db.Uuid
  customerName    String
  /// Facultatif.
  customerPhone   String?
  partySize       Int
  startsAt        DateTime
  endsAt          DateTime
  status          ReservationStatus @default(PENDING)
  notes           String?
  createdById     String            @db.Uuid
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  establishment Establishment          @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  table         DiningTable?           @relation(fields: [tableId], references: [id], onDelete: NoAction)
  zone          DiningZone?            @relation(fields: [zoneId], references: [id], onDelete: NoAction)
  createdBy     OrganizationMembership @relation("ReservationCreatedBy", fields: [createdById], references: [id], onDelete: NoAction)

  @@index([establishmentId, startsAt])
  @@index([tableId, startsAt])
}
