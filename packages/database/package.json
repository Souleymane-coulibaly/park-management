{
  "name": "@ocall/database",
  "version": "0.1.0",
  "private": true,
  "description": "Schéma Prisma, migrations, client et scripts de base de données Ocall Park.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "postinstall": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "dotenv -e ../../apps/api/.env -- tsx scripts/db-check.ts",
    "migrate:dev": "dotenv -e ../../apps/api/.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../apps/api/.env -- prisma migrate deploy",
    "migrate:status": "dotenv -e ../../apps/api/.env -- prisma migrate status",
    "bootstrap-super-admin": "dotenv -e ../../apps/api/.env -- tsx scripts/bootstrap-super-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "argon2": "^0.41.1",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3"
  }
}
